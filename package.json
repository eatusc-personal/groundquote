{
  "name": "groundquote",
  "version": "1.2.0",
  "private": true,
  "description": "Ask a document. See the evidence. Trust the answer.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test:run && npm run eval && npm run test:e2e && npm run audit:prod && npm run build",
    "eval": "tsx scripts/run-evals.ts",
    "audit:prod": "npm audit --omit=dev",
    "capture:media": "tsx scripts/capture-media.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.5",
    "openai": "6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
