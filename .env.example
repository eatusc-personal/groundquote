# Optional. Claude writes answers when ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional. OpenAI provides embeddings, and writes answers when no Anthropic key is set.
# Without either key, Groundquote uses a transparent extractive fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Enables anonymous, aggregate answer-feedback storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
